    "analytics": {
      "enabled": false,
      "provider": "google",
      "id": ""
    },
    "rss": {
      "enabled": false,
      "url": "/feed.xml"
    },
    "pwa": {
      "enabled": false,
      "name": "bthavanish's blog",
      "shortName": "Blog",
      "theme": "#cd7c53"
    }
  },
  
  "markdown": {
